# Copie este arquivo para ".env" e preencha com as chaves reais.
# NUNCA commite o ".env" de verdade — ele já está no .gitignore.
# Usado pelas Netlify Functions em netlify/functions/*.mjs

# Brevo (envio de email transacional)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Faços
BREVO_REPLY_EMAIL=

# Mercado Pago (chave PRIVADA — nunca no frontend)
MP_ACCESS_TOKEN=

# Supabase - service role key (privilégio total, ignora RLS).
# Gere em: Supabase > Project Settings > API > service_role
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic (IA do chat de suporte "Buzz", no botão Ajuda/Suporte)
# Gere em: console.anthropic.com > Settings > API Keys
ANTHROPIC_API_KEY=
